# Gemini API কনফিগ — এই ফাইলটি কপি করে `.env` বানান
#   copy .env.example .env        (Windows PowerShell)
#   cp .env.example .env          (Linux/macOS)
#
# কী তৈরি: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ডিফল্ট মডেল (gemini-3.5-flash) এবং রেট লিমিটের ক্ষেত্রে ব্যাকআপ মডেল (gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ড্যাশবোর্ড/সার্ভার কোন পোর্টে চলবে (ঐচ্ছিক)
# PORT=8765


# Ollama (স্থানীয়/স্ব-হোস্ট) কনফিগ
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# Ollama Cloud (ঐচ্ছিক): লোকাল Ollama-র বদলে ক্লাউড মডেল ব্যবহার করতে
# উপরের OLLAMA_BASE_URL ও OLLAMA_MODEL এর বদলে নিচের তিনটি লাইন ব্যবহার করুন।
# কী তৈরি: https://ollama.com/settings/keys
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_api_key
# OLLAMA_MODEL=gpt-oss:120b

# OpenRouter (OpenAI-সামঞ্জস্যপূর্ণ) কনফিগ
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ডিফল্ট AI প্রোভাইডার: gemini / ollama / openrouter
AI_PROVIDER=gemini
